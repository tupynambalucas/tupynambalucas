# ---------------------------------------------------------------- #
# CORTEX ECOSYSTEM — DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in sensitive credentials.
# ---------------------------------------------------------------- #

DOCKER_ENV=dev
APP_ENV=dev
NODE_ENV=development
COMPOSE_PROFILES=core

# ==========================================
# CORE INGRESS GATEWAY (agentgateway)
# ==========================================
GATEWAY_PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ==========================================
# MCP GUARDRAILS SERVICE
# ==========================================
GUARDRAILS_PORT=9001
GUARDRAILS_HOST=0.0.0.0

# ==========================================
# CORE MEMORY (MongoDB Replica Set & API)
# ==========================================
MEMORY_MONGO_INITDB_ROOT_USERNAME=cortex_admin
MEMORY_MONGO_INITDB_ROOT_PASSWORD=cortex_password_dev
MEMORY_MONGO_INITDB_DATABASE=cortex_memory
MEMORY_MONGO_PORT=27018
MONGODB_URI=mongodb://cortex_admin:cortex_password_dev@mongodb-db:27017/cortex_memory?authSource=admin
MEMORY_API_PORT=3006
MEMORY_API_HOST=0.0.0.0
MEMORY_WEB_PORT=9006

# ==========================================
# MCP DATA PLANE SERVICES
# ==========================================
CONTEXT7_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
GRAFANA_CLOUD_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
MEMORY_MCP_PORT=8080
PLAYWRIGHT_MCP_PORT=8080
PLAYWRIGHT_MCP_HOST=0.0.0.0
PLAYWRIGHT_MCP_BROWSER=chromium
PLAYWRIGHT_MCP_HEADLESS=true
PLAYWRIGHT_MCP_NO_SANDBOX=true
PLAYWRIGHT_MCP_ALLOWED_HOSTS=*

# ==========================================
# AI AGENT RUNTIMES (Control Plane)
# ==========================================
GEMINI_API_KEY=
GITHUB_TOKEN=
