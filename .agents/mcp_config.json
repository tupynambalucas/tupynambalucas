{
  "mcpServers": {
    "podman-mcp": {
      "command": "pnx",
      "args": ["-y", "podman-mcp-server@latest"]
    },
    "firecrawl-mcp": {
      "command": "pnx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "$FIRECRAWL_API_KEY"
      }
    },
    "context7-mcp": {
      "command": "pnx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "$CONTEXT7_API_KEY"]
    }
  }
}
