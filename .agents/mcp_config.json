{
  "mcpServers": {
    "agentgateway": {
      "url": "https://agentgateway-mcp-dev.tupynambalucas.dev/mcp",
      "headers": {
        "x-mcp-token": "${env:CORTEX_MCP_TOKEN}"
      },
      "lifecycle": "eager"
    },
    "podman-mcp": {
      "command": "pnx",
      "args": ["-y", "podman-mcp-server@latest"]
    }
  }
}
