{
  "mcpServers": {
    "podman-mcp": {
      "command": "pnx",
      "args": ["-y", "podman-mcp-server@latest"]
    },
    "firecrawl-mcp": {
      "command": "pnx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "fc-YOUR_FIRECRAWL_API_KEY_HERE"
      }
    },
    "context7-mcp": {
      "command": "pnx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "ctx7sk-YOUR_CONTEXT7_API_KEY_HERE"]
    }
  }
}
