{
  "$schema": "./node_modules/turbo/schema.json",
  "remoteCache": {
    "apiUrl": "http://localhost:3008",
    "signature": false
  },
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"],
      "env": [
        "SYNC_TRANSLATIONS",
        "CROWDIN_PROJECT_ID",
        "CROWDIN_PERSONAL_TOKEN",
        "CLOUDFLARE_R2_ASSETS_PUBLIC_URL"
      ]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
