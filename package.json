{
  "name": "@tupynambalucas-dev/platform",
  "version": "1.0.0",
  "private": true,
  "description": "Root monorepo workspace for the ecosystem.",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "MIT",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas-dev/platform.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "scripts": {
    "// Corporate Context (Web, API & Shared Domain)": "-----------------------------",
    "corporate:dev": "kill-port 3000 5173 && turbo run dev --filter=@tupynambalucas-dev/corporate-web --filter=@tupynambalucas-dev/corporate-api",
    "corporate:build": "turbo run build --filter=@tupynambalucas-dev/corporate-web --filter=@tupynambalucas-dev/corporate-api --filter=@tupynambalucas-dev/corporate-core",
    "corporate:lint": "turbo run lint --filter=@tupynambalucas-dev/corporate-web --filter=@tupynambalucas-dev/corporate-api --filter=@tupynambalucas-dev/corporate-core",
    "corporate:typecheck": "turbo run typecheck --filter=@tupynambalucas-dev/corporate-web --filter=@tupynambalucas-dev/corporate-api --filter=@tupynambalucas-dev/corporate-core",
    "corporate:web:dev": "pnpm --filter @tupynambalucas-dev/corporate-web dev",
    "corporate:api:dev": "pnpm --filter @tupynambalucas-dev/corporate-api dev",
    "corporate:core:typecheck": "pnpm --filter @tupynambalucas-dev/corporate-core typecheck",
    "// Corporate Portal (Documentation Hub & Knowledge Base)": "--------------------",
    "portal:dev": "pnpm --filter @tupynambalucas-dev/corporate-portal start",
    "portal:dev:pt": "pnpm --filter @tupynambalucas-dev/corporate-portal start:pt",
    "portal:build": "turbo run build --filter=@tupynambalucas-dev/corporate-portal",
    "portal:preview": "pnpm portal:build && pnpm --filter @tupynambalucas-dev/corporate-portal serve",
    "portal:clear": "pnpm --filter @tupynambalucas-dev/corporate-portal clear",
    "portal:down": "pnpm dlx kill-port 3002",
    "portal:typecheck": "turbo run typecheck --filter=@tupynambalucas-dev/corporate-portal --filter=@tupynambalucas-dev/corporate-preset --filter=@tupynambalucas-dev/corporate-theme --filter=@tupynambalucas-dev/corporate-collections",
    "portal:lint": "turbo run lint --filter=@tupynambalucas-dev/corporate-portal --filter=@tupynambalucas-dev/corporate-preset --filter=@tupynambalucas-dev/corporate-theme --filter=@tupynambalucas-dev/corporate-collections",
    "portal:generate:changelog": "pnpm --filter @tupynambalucas-dev/corporate-portal generate:changelog",
    "portal:generate:roadmap": "pnpm --filter @tupynambalucas-dev/corporate-portal generate:roadmap",
    "portal:collections:typecheck": "pnpm --filter @tupynambalucas-dev/corporate-collections typecheck",
    "portal:collections:lint": "pnpm --filter @tupynambalucas-dev/corporate-collections lint",
    "portal:preset:typecheck": "pnpm --filter @tupynambalucas-dev/corporate-preset typecheck",
    "portal:preset:lint": "pnpm --filter @tupynambalucas-dev/corporate-preset lint",
    "portal:theme:typecheck": "pnpm --filter @tupynambalucas-dev/corporate-theme typecheck",
    "portal:theme:lint": "pnpm --filter @tupynambalucas-dev/corporate-theme lint",
    "// Hub Context (Internal Platform: Studio, Cortex, Observability)": "-----------",
    "hub:typecheck": "turbo run typecheck --filter=\"@tupynambalucas-dev/cortex-*\" --filter=\"@tupynambalucas-dev/studio-*\"",
    "hub:lint": "turbo run lint --filter=\"@tupynambalucas-dev/cortex-*\" --filter=\"@tupynambalucas-dev/studio-*\"",
    "studio:lint": "pnpm --filter \"@tupynambalucas-dev/studio-*\" lint",
    "studio:typecheck": "pnpm --filter \"@tupynambalucas-dev/studio-*\" typecheck",
    "studio:bucket": "pnpm --filter @tupynambalucas-dev/studio-bucket bucket",
    "cortex:typecheck": "turbo run typecheck --filter=\"@tupynambalucas-dev/cortex-*\"",
    "cortex:lint": "turbo run lint --filter=\"@tupynambalucas-dev/cortex-*\"",
    "// Renderer Context": "----------------------------------------------------------",
    "renderer:clean": "pnpm --filter @tupynambalucas-dev/renderer clean",
    "renderer:generate": "pnpm --filter @tupynambalucas-dev/renderer generate",
    "renderer:typecheck": "pnpm --filter @tupynambalucas-dev/renderer typecheck",
    "renderer:lint": "pnpm --filter @tupynambalucas-dev/renderer lint",
    "// Shared Context": "------------------------------------------------------------",
    "shared:lint": "turbo run lint --filter=@tupynambalucas-dev/shared-*",
    "shared:typecheck": "turbo run typecheck --filter=@tupynambalucas-dev/shared-*",
    "// Tools Context": "-------------------------------------------------------------",
    "provision": "pnpm --filter @tupynambalucas-dev/tools-provisioner start",
    "tools:lint": "turbo run lint --filter=@tupynambalucas-dev/tools-*",
    "tools:typecheck": "turbo run typecheck --filter=@tupynambalucas-dev/tools-*",
    "github:services:up": "pnpm --filter @tupynambalucas-dev/tools-github github:services:up",
    "github:services:down": "pnpm --filter @tupynambalucas-dev/tools-github github:services:down",
    "github:services:reset": "pnpm --filter @tupynambalucas-dev/tools-github github:services:reset",
    "// Infrastructure Context": "---------------------------------------------------",
    "infra:dev": "pnpm --filter @tupynambalucas-dev/k8s dev",
    "infra:build": "pnpm --filter @tupynambalucas-dev/k8s build",
    "infra:delete": "pnpm --filter @tupynambalucas-dev/k8s delete",
    "infra:stop": "pnpm infra:delete",
    "// CI/CD & Quality": "----------------------------------------------------------",
    "format:check": "prettier --check --ignore-path shared/config/.prettierignore .",
    "format:write": "prettier --write --ignore-path shared/config/.prettierignore .",
    "version:changeset": "changeset",
    "version:bump": "changeset version",
    "version:publish": "changeset publish",
    "project:clear": "pnpm dlx npkill",
    "git:ignore-compiled-docs": "git update-index --skip-worktree CHANGELOG.md ROADMAP.md",
    "git:track-compiled-docs": "git update-index --no-skip-worktree CHANGELOG.md ROADMAP.md",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@clack/prompts": "catalog:",
    "@docusaurus/eslint-plugin": "catalog:tooling-stack",
    "@eslint-react/eslint-plugin": "catalog:web-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@tupynambalucas-dev/shared-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import-x": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "husky": "catalog:",
    "kill-port": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "wrangler": "catalog:"
  },
  "prettier": "@tupynambalucas-dev/shared-config",
  "lint-staged": {
    "**/*.{js,mjs,ts,tsx,mdx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "**/*.{json,yaml,md,css,html}": [
      "prettier --write --ignore-path shared/config/.prettierignore"
    ]
  }
}
