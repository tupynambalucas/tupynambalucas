{
  "name": "tupynambalucas/monorepo",
  "private": true,
  "description": "Root monorepo workspace for the ecosystem.",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "MIT",
  "homepage": "https://docs.tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/tupynambalucas.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "scripts": {
    "// Docs Context": "---------------------------------------------",
    "docs:typecheck": "turbo run typecheck --filter=\"@monorepo/docs-*\"",
    "docs:lint": "turbo run lint --filter=\"@monorepo/docs-*\"",
    "docs:docusaurus:typecheck": "pnpm --filter @monorepo/docs-docusaurus typecheck",
    "docs:docusaurus:lint": "pnpm --filter @monorepo/docs-docusaurus lint",
    "docs:preset:typecheck": "pnpm --filter @monorepo/docs-preset typecheck",
    "docs:preset:lint": "pnpm --filter @monorepo/docs-preset lint",
    "docs:theme:typecheck": "pnpm --filter @monorepo/docs-theme typecheck",
    "docs:theme:lint": "pnpm --filter @monorepo/docs-theme lint",
    "docs:docusaurus:generate:changelog": "pnpm --filter @monorepo/docs-docusaurus docs:generate:changelog",
    "docs:docusaurus:generate:roadmap": "pnpm --filter @monorepo/docs-docusaurus docs:generate:roadmap",
    "docs:docusaurus:dev": "pnpm --filter @monorepo/docs-docusaurus start",
    "docs:docusaurus:dev:pt": "pnpm --filter @monorepo/docs-docusaurus start:pt",
    "docs:docusaurus:build": "turbo run build --filter=@monorepo/docs-docusaurus",
    "docs:docusaurus:preview": "pnpm docs:docusaurus:build && pnpm --filter @monorepo/docs-docusaurus serve",
    "docs:docusaurus:clear": "pnpm --filter @monorepo/docs-docusaurus clear",
    "docs:docusaurus:down": "pnpm dlx kill-port 3002",
    "// Hub Context": "---------------------------------------------",
    "hub:dev": "kill-port 3000 5173 && pnpm hub:up && turbo run dev --filter=@monorepo/hub-*",
    "hub:build": "turbo run build --filter=@monorepo/hub-*",
    "hub:lint": "turbo run lint --filter=@monorepo/hub-*",
    "hub:typecheck": "turbo run typecheck --filter=@monorepo/hub-*",
    "hub:up": "podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.override.yaml --env-file hub/infrastructure/docker/.env.dev --profile dev up -d --build",
    "hub:down": "podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.override.yaml --env-file hub/infrastructure/docker/.env.dev --profile dev down && kill-port 3000 5173",
    "hub:reset": "podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.override.yaml --env-file hub/infrastructure/docker/.env.dev --profile dev down --volumes && podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.override.yaml --env-file hub/infrastructure/docker/.env.dev --profile dev up -d --build",
    "hub:prod": "podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.prod.yaml --env-file hub/infrastructure/docker/.env.prod --profile prod up -d --build",
    "hub:staging": "podman compose -f hub/infrastructure/docker/compose.yaml -f hub/infrastructure/docker/compose.prod.yaml --env-file hub/infrastructure/docker/.env.staging --profile staging up -d --build",
    "// Renderer Context": "---------------------------------------------",
    "renderer:clean": "pnpm --filter @monorepo/renderer clean",
    "renderer:generate": "pnpm --filter @monorepo/renderer generate",
    "renderer:typecheck": "pnpm --filter @monorepo/renderer typecheck",
    "renderer:lint": "pnpm --filter @monorepo/renderer lint",
    "// Studio Context (Skaffold Hot-Reload)": "---------------------------------------------",
    "studio:lint": "pnpm --filter \"@monorepo/studio-*\" lint",
    "studio:typecheck": "pnpm --filter \"@monorepo/studio-*\" typecheck",
    "studio:bucket": "pnpm --filter @monorepo/studio-bucket bucket",
    "// Cortex Context (Skaffold Hot-Reload)": "---------------------------------------------",
    "cortex:typecheck": "turbo run typecheck --filter=\"@monorepo/cortex-*\"",
    "cortex:lint": "turbo run lint --filter=\"@monorepo/cortex-*\"",
    "// Tools Context": "---------------------------------------------",
    "provision": "pnpm --filter @monorepo/tools-provisioner start",
    "tools:lint": "turbo run lint --filter=@monorepo/tools-*",
    "tools:typecheck": "turbo run typecheck --filter=@monorepo/tools-*",
    "github:services:up": "pnpm --filter @monorepo/tools-github github:services:up",
    "github:services:down": "pnpm --filter @monorepo/tools-github github:services:down",
    "github:services:reset": "pnpm --filter @monorepo/tools-github github:services:reset",
    "// Infrastructure Context": "----------------------------------------",
    "minikube:up": "minikube start --driver=podman --container-runtime=docker --cpus=6 --memory=8192 --addons=metrics-server",
    "minikube:stop": "minikube stop",
    "minikube:delete": "minikube delete",
    "minikube:reset": "minikube delete && minikube start --driver=podman --container-runtime=docker --cpus=6 --memory=8192 --addons=metrics-server",
    "minikube:tunnel": "minikube tunnel",
    "minikube:status": "minikube status",
    "minikube:logs": "minikube logs --follow",
    "infra:dev": "pnpm --filter @monorepo/infrastructure dev",
    "infra:delete": "pnpm --filter @monorepo/infrastructure delete",
    "infra:stop": "pnpm infra:delete && pnpm minikube:stop",
    "// CI/CD & Quality": "-------------------------------------------------",
    "format:check": "prettier --check --ignore-path shared/config/.prettierignore .",
    "format:write": "prettier --write --ignore-path shared/config/.prettierignore .",
    "version:changeset": "changeset",
    "version:bump": "changeset version",
    "version:publish": "changeset publish",
    "project:clear": "pnpm dlx npkill",
    "husky:test": "tsx tools/scripts/test-hooks.ts",
    "git:ignore-compiled-docs": "git update-index --skip-worktree CHANGELOG.md ROADMAP.md",
    "git:track-compiled-docs": "git update-index --no-skip-worktree CHANGELOG.md ROADMAP.md",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@clack/prompts": "catalog:",
    "@docusaurus/eslint-plugin": "catalog:tooling-stack",
    "@eslint-react/eslint-plugin": "catalog:web-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@monorepo/shared-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import-x": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "husky": "catalog:",
    "kill-port": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "wrangler": "catalog:"
  },
  "prettier": "@monorepo/shared-config",
  "lint-staged": {
    "**/*.{js,mjs,ts,tsx,mdx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "**/*.{json,yaml,md,css,html}": [
      "prettier --write --ignore-path shared/config/.prettierignore"
    ]
  }
}
