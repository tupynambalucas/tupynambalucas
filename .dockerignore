# ---------------------------------------------------------------- #
# MONOREPO ROOT — DOCKER BUILD CONTEXT IGNORE
# Applied when build context is the monorepo root (API and Web builds).
# Excludes anything that should not enter the Docker build context.
# ---------------------------------------------------------------- #

# Version control
.git
.gitignore

# Dependencies (rebuilt inside the image)
**/node_modules

# Build artifacts (rebuilt inside the image)
**/dist
!cortex/mcp/services/*/dist
**/build
**/.turbo
**/*.tsbuildinfo

# Secrets — NEVER copy env files into a Docker image
**/.env
**/.env.*
skaffold.env

# Logs
**/*.log
**/logs

# Test and coverage
**/coverage
**/__tests__
**/*.test.ts
**/*.spec.ts

# Editor and OS artifacts
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db

# Documentation and Non-Code Folders
!docs/
!docs/**
docs/services/docusaurus/node_modules/
docs/services/docusaurus/.docusaurus/
docs/services/docusaurus/build/
docs/services/docusaurus/.turbo/
.agents/
.github/
.system_generated/

node_modules
*/*/node_modules
*/*/*/node_modules
docs/packages/*/node_modules/
docs/packages/*/dist/
