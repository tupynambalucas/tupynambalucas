# ---------------------------------------------------------------- #
# MONOREPO ROOT — DOCKER BUILD CONTEXT IGNORE
# Applied when build context is the monorepo root (API and Web builds).
# Excludes anything that should not enter the Docker build context.
# ---------------------------------------------------------------- #

# Version control
.git
.gitignore

# Dependencies (rebuilt inside the image)
**/node_modules

# Build artifacts (rebuilt inside the image)
**/dist
!hub/cortex/mcp/services/*/dist
**/build
**/.turbo
**/*.tsbuildinfo

# Secrets — NEVER copy env files into a Docker image
**/.env
**/.env.*
skaffold.env

# Logs
**/*.log
**/logs

# Test and coverage
**/coverage
**/__tests__
**/*.test.ts
**/*.spec.ts

# Editor and OS artifacts
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db

# Documentation and Non-Code Folders
!corporate/
!corporate/**
corporate/**/node_modules/
corporate/**/.docusaurus/
corporate/**/build/
corporate/**/.turbo/
corporate/**/references/
corporate/services/portal/node_modules/
corporate/services/portal/.docusaurus/
corporate/services/portal/build/
corporate/services/portal/.turbo/
.agents/
.github/
.system_generated/

node_modules
*/*/node_modules
*/*/*/node_modules
corporate/packages/*/node_modules/
corporate/packages/*/dist/
**/references
