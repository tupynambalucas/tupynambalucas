{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copilot CLI [Host]",
      "type": "shell",
      "command": "copilot",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true,
        "reveal": "always",
        "clear": true,
        "group": "llm-cli-group"
      },
      "isBackground": false
    },
    {
      "label": "Antigravity CLI",
      "type": "process",
      "command": "wt.exe",
      "args": [
        "--window",
        "-1",
        "--maximized",
        "--profile",
        "Antigravity",
        "--startingDirectory",
        "${workspaceFolder}",
        "pwsh",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/scripts/launch-agy.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "Open External Terminal (pwsh)",
      "type": "shell",
      "command": "wt -d \"${workspaceFolder}\" pwsh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "focus": false
      }
    }
  ]
}
