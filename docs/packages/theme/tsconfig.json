{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@theme/*": ["./src/theme/*"],
      "@theme-original/*": ["../../../node_modules/@docusaurus/theme-classic/src/theme/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
