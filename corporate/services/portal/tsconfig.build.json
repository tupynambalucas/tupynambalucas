{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mdx",
    "docusaurus.config.ts",
    "../../collections/namespaces/portal/portal.config.ts"
  ],
  "exclude": ["node_modules", "build", "**/*.test.*", "**/*.spec.*"],
