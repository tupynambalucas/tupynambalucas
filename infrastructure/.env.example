# Seed Job: Initial user provisioning (studio-penpot-seed.yaml)
# Generate a bcrypt hash (cost 12) for each password with:
#   htpasswd -bnBC 12 "" "your_password" | tr -d ':\n' | sed 's/$2y/$2a/'
PENPOT_ADMIN_FULLNAME=<YOUR_PENPOT_ADMIN_FULLNAME>
PENPOT_ADMIN_EMAIL=<YOUR_PENPOT_ADMIN_EMAIL>
PENPOT_ADMIN_PASSWORD=<YOUR_PENPOT_ADMIN_PASSWORD>

# Frontend Service
