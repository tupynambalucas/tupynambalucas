# ---------------------------------------------------------------- #
# PROFILE RENDERER — ENVIRONMENT CONFIGURATION
# ---------------------------------------------------------------- #

# GitHub — Personal access token for fetching metrics and committing generated assets
RENDERER_GH_PAT=<YOUR_RENDERER_GH_PAT>

# Optional — Comma-separated list or JSON array of repository glob patterns to exclude from statistics
# Example: EXCLUDE_REPOS="*test*, demo-*, archive-repo"
EXCLUDE_REPOS=

# Optional — Comma-separated list or JSON array of language glob patterns to exclude from statistics
# Example: EXCLUDE_LANGS="HTML, CSS, Shell"
EXCLUDE_LANGS=

# Optional — Exclude private repositories from statistics cards (default: false)
EXCLUDE_PRIVATE=false
